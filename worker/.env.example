# Port for the Express server (Railway sets this automatically)
PORT=3001

# API key for authenticating requests from the Next.js app
# Generate a secure random key: openssl rand -hex 32
API_KEY=your_api_key_here

# Comma-separated list of allowed CORS origins (restrict in production)
# Example: https://www.accessaudit.com,https://accessaudit.com
ALLOWED_ORIGINS=
