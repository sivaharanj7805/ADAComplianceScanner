# =============================================================================
# AccessAudit - Production Environment Variables
# =============================================================================
# Copy this file and set real values in your Vercel project settings.
# NEVER commit actual secrets to the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# The canonical URL of your production deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Found in: Stripe Dashboard > Developers > API keys
# Use LIVE keys for production (sk_live_... / pk_live_...)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Found in: Stripe Dashboard > Developers > Webhooks > Signing secret
# Endpoint URL: https://your-domain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Price IDs for subscription plans
# Found in: Stripe Dashboard > Products > select product > Pricing
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_AGENCY=price_your_agency_price_id

# -----------------------------------------------------------------------------
# Scanner Worker (Railway)
# -----------------------------------------------------------------------------
# The URL of your deployed Railway scanning worker (no trailing slash)
SCANNER_API_URL=https://your-worker.up.railway.app
# Must match the API_KEY set in the Railway worker environment
SCANNER_API_KEY=your_scanner_api_key

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Found in: Resend Dashboard > API Keys
RESEND_API_KEY=re_your_resend_api_key
# Optional: customize the sender address (must be a verified domain in Resend)
EMAIL_FROM=AccessAudit <notifications@your-domain.com>
