# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Stripe
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in the Stripe dashboard)
STRIPE_PRICE_AGENCY_STARTER=price_xxx
STRIPE_PRICE_AGENCY_GROWTH=price_xxx
STRIPE_PRICE_AGENCY_SCALE=price_xxx
STRIPE_PRICE_ECOM_SHIELD=price_xxx
STRIPE_PRICE_ECOM_GUARD=price_xxx
STRIPE_PRICE_ECOM_FORTRESS=price_xxx
STRIPE_PRICE_MUNICIPAL_STARTER=price_xxx
STRIPE_PRICE_MUNICIPAL_PRO=price_xxx

# =============================================================================
# Resend (Email)
# =============================================================================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=AccessAudit <notifications@accessaudit.com>

# =============================================================================
# Scanner Worker (Railway)
# =============================================================================
SCANNER_API_URL=http://localhost:3001
SCANNER_API_KEY=your_scanner_api_key

# =============================================================================
# Cron Authentication
# =============================================================================
CRON_SECRET=your_cron_secret
